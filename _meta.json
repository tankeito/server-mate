{
  "name": "server-mate",
  "version": "1.2.0",
  "description": "Lightweight server monitoring and AI operations workflow for Linux hosts running Nginx or Apache",
  "author": "tankeito",
  "license": "MIT",
  "homepage": "https://github.com/tankeito/server-mate",
  "repository": {
    "type": "git",
    "url": "https://github.com/tankeito/server-mate.git"
  },
  "keywords": [
    "server-monitoring",
    "ai-ops",
    "multi-site",
    "telegram",
    "systemd",
    "linux",
    "nginx",
    "apache",
    "log-analysis",
    "webhook-alerts",
    "auto-remediation"
  ],
  "platform": [
    "CentOS",
    "Ubuntu",
    "Debian",
    "Rocky Linux",
    "AlmaLinux"
  ],
  "language": [
    "Python"
  ],
  "dependencies": {
    "python": ">=3.8",
    "packages": [
      "psutil",
      "pyyaml",
      "matplotlib"
    ],
    "optional": [
      "geoip2",
      "requests"
    ]
  },
  "features": [
    "Multi-site matrix configuration with isolated per-domain rollups",
    "Real-time host metrics (CPU, memory, disk, network)",
    "Nginx/Apache access and error log parsing",
    "Traffic analysis (PV, UV, IP, QPS, bandwidth)",
    "Spider detection and traffic separation",
    "Threshold-based webhook alerts",
    "Telegram bot alert delivery",
    "AI alert diagnosis with plain-language remediation hints",
    "AI-powered error diagnosis",
    "Daily/Weekly/Monthly PDF reports",
    "PDF-safe long URL and referer truncation",
    "Guarded auto-ban and auto-heal automation"
  ],
  "integrations": [
    "DingTalk webhook",
    "WeCom webhook",
    "Feishu webhook",
    "Telegram bot API",
    "OpenClaw AI analyzer",
    "SQLite for local storage"
  ],
  "environment_variables": {
    "required": [],
    "optional": [
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_CHAT_ID"
    ],
    "managed_by_runtime": [
      "OPENAI_API_KEY"
    ],
    "primary": "OPENAI_API_KEY"
  },
  "credentials": {
    "managed_env": [
      "OPENAI_API_KEY"
    ],
    "optional_env": [
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_CHAT_ID"
    ],
    "config_secrets": [
      "notifications.webhooks.*.url",
      "notifications.webhooks.telegram.bot_token",
      "notifications.webhooks.telegram.chat_id",
      "notifications.ai_analysis.api_key_env"
    ],
    "notes": [
      "OPENAI_API_KEY is injected by the OpenClaw runtime when AI analysis is enabled.",
      "Telegram bot_token and chat_id may be stored in config.yaml or supplied via environment variables.",
      "Webhook URLs and tokens are operator-supplied secrets stored in config.yaml."
    ]
  },
  "security": {
    "default_mode": "read-only collection with Guarded Automation dry_run enabled",
    "privileged_operations": [
      "Firewall ban and unban commands when auto_ban is enabled",
      "Service restart commands when auto_heal is enabled"
    ],
    "requires_root_when_enabled": true,
    "data_egress": [
      "User-configured webhook endpoints",
      "Telegram bot API when Telegram delivery is enabled",
      "OpenAI API when AI analysis is enabled"
    ]
  },
  "scripts": {
    "agent": "python3 ./scripts/server_agent.py --config ./config.yaml --once",
    "report-daily": "python3 ./scripts/report_generator.py --config ./config.yaml pdf --range daily --send",
    "report-weekly": "python3 ./scripts/report_generator.py --config ./config.yaml pdf --range weekly --send",
    "report-monthly": "python3 ./scripts/report_generator.py --config ./config.yaml pdf --range monthly --send"
  },
  "config": {
    "default_config_file": "./config.yaml",
    "default_database_file": "./metrics.db",
    "default_log_dir": "./logs/",
    "default_report_dir": "./reports/",
    "default_data_dir": "./"
  },
  "created_at": "2026-03-26",
  "updated_at": "2026-03-27"
}
